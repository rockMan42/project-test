<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.projecttest.repository.ProjectRepository">
    <select id="selectInfoByPage" resultType="org.example.projecttest.entity.Project">
        select id,product_type,create_time from pr_reservoir_project Limit #{start},#{size}
    </select>

    <select id="selectCountByPage" resultType="int">
        select count(*) from pr_reservoir_project
    </select>
</mapper>